
{
  "name": "dv-hub",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "echo 'TODO DV-008: esbuild src/server.ts --bundle --platform=node --outfile=dist/server.js' && exit 1",
    "preview": "wrangler pages dev dist",

    "dev:sandbox": "wrangler pages dev dist --d1=dv-hub-production --local --ip 0.0.0.0 --port 3000",
    "dev:node": "echo 'TODO DV-008: node dist/server.js' && exit 1",

    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name dv-hub",
    "deploy:vps": "echo 'TODO DV-008: rsync dist/ + ssh pm2 restart' && exit 1",
    "deploy": "npm run deploy:cf",

    "cf-typegen": "wrangler types --env-interface CloudflareBindings",

    "context:init": "git submodule update --init --recursive",
    "context:sync": "cd context && git pull origin main && cd ..",
    "context:bump": "git add context && git commit -m \"chore: bump context\"",
    "context:status": "cd context && git status && cd ..",
    "context:log": "cd context && git log --oneline -10 && cd ..",

    "db:migrate:local": "wrangler d1 migrations apply dv-hub-production --local",
    "db:seed": "wrangler d1 execute dv-hub-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:export": "echo 'TODO DV-007: wrangler d1 export dv-hub-production --output=./backup.sql' && exit 1",

    "lint": "eslint . --ext .ts",
    "test": "jest",
    "ci": "npm run lint && npm run test && npm run build",
    "prepare-test-env": "npm run db:reset && npm run db:seed"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260401.1",
    "hono": "^4.12.9"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
