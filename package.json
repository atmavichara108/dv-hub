{
  "name": "dv-hub",
  "type": "module",
  "scripts": {
    "task:sync": "bash scripts/sync-task.sh",
    "dev": "tsx watch src/server.ts",
    "build": "vite build",
    "build:server": "vite build",
    "start": "node dist/server.js",
    "dev:cf": "wrangler pages dev dist --d1=dv-hub-production --local --ip 0.0.0.0 --port 3000",
    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name dv-hub",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "deploy": "npm run deploy:vps",
    "context:init": "git submodule update --init --recursive",
    "context:sync": "cd context && git pull origin main && cd ..",
    "context:bump": "git add context && git commit -m \"chore: bump context\"",
    "context:status": "cd context && git status && cd ..",
    "context:log": "cd context && git log --oneline -10 && cd ..",
    "db:init": "node scripts/init-db.js",
    "db:migrate:local": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "rm -f data/dv-hub.db data/dv-hub.db-wal data/dv-hub.db-shm && npm run db:init",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "ci": "npm run lint && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.9",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.2",
    "tsx": "^4.22.4",
    "typescript": "^5.4.2",
    "vite": "^6.3.5"

  }
}
