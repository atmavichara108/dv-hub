{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "lsp": true,
  "instructions": [
    "docs/product-vision.md",
    "docs/architecture.md",
    "docs/glossary.md",
    "docs/roadmap.md",
    "docs/infra-runbook.md",
    "context/DV/Movement/DV Foundation.md",
    "context/DV/Structure/**/*.md",
    "context/DV/Site/**/*.md",
    "context/DV/Research/Research Workflow.md",
    "context/DV/Operations/Kanban/Kanban Board.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "cat .env*": "deny",
      "cat **/.env*": "deny",
      "cat **/auth.json": "deny",
      "cat **/.ssh/*": "deny",
      "cat **/keys-passwords*": "deny",
      "cat /etc/**": "deny",
      "cat /root/**": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "webfetch": "allow"
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "opencode-go/qwen3.7-max",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": { "*": "allow" }
      }
    },
    "build": {
      "mode": "primary",
      "model": "opencode/deepseek-v4-flash",
      "temperature": 0.1,
      "steps": 30,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": { "*": "allow" }
      }
    },
    "reviewer": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.1,
      "steps": 15,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "grep*": "allow",
          "cat*": "allow",
          "ls*": "allow"
        }
      }
    },
    "researcher": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.6-plus",
      "temperature": 0.3,
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": { "*": "deny" },
        "webfetch": "allow"
      }
    },
    "infra": {
      "mode": "primary",
      "model": "opencode-go/qwen3.7-max",
      "temperature": 0.1,
      "steps": 30,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "ssh *": "deny",
          "sudo *": "deny",
          "git push --force*": "deny"
        },
        "webfetch": "allow"
      }
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
      },
      "enabled": true
    }
  }
}
