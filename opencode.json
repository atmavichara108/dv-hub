
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/product-vision.md",
    "docs/architecture.md",
    "docs/glossary.md",
    "docs/roadmap.md",
    "docs/infra-runbook.md",
    "context/DV/Movement/DV Foundation.md",
    "context/DV/Movement/Manifesto.md",
    "context/DV/Movement/Principles.md",
    "context/DV/Structure/**/*.md",
    "context/DV/Site/**/*.md",
    "context/DV/Research/Research Workflow.md",
    "context/DV/Operations/Kanban/Kanban Board.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "ls": "allow",
      "find *": "allow",
      "cat *": "ask",
      "cat docs/*": "allow",
      "cat src/**": "allow",
      "cat tests/**": "allow",
      "cat migrations/*": "allow",
      "cat context/DV/**": "allow",
      "cat package.json": "allow",
      "cat opencode.json": "allow",
      "cat AGENTS.md": "allow",
      "cat README.md": "allow",
      "cat .env*": "deny",
      "cat **/.env*": "deny",
      "cat **/auth.json": "deny",
      "cat **/.ssh/*": "deny",
      "cat **/keys-passwords*": "deny",
      "cat /etc/**": "deny",
      "cat /root/**": "deny",
      "git status *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git diff": "allow",
      "git log *": "allow",
      "git log": "allow",
      "git branch *": "allow",
      "git branch": "allow",
      "npm run lint": "allow",
      "npm run test": "allow",
      "npm run build": "allow",
      "npm run context:status": "allow",
      "npm run context:log": "allow",
      "npx tsc *": "allow",
      "rm *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "webfetch": "allow"
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
      },
      "enabled": true
    }
  }
}
